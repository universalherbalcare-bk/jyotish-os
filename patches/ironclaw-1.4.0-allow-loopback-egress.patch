+/// Opt-in loopback exemption for `deny_private_ip_ranges` (Jyotish-OS local patch).
+///
+/// When this environment variable is set to `1`/`true`/`yes`/`on`, an IP in
+/// `127.0.0.0/8` or exactly `::1` is NOT treated as a denied private target,
+/// so a host-mediated request (hosted-MCP, `builtin.http`) may reach a server
+/// bound to the local machine. Every other non-public range — `10/8`,
+/// `172.16/12`, `192.168/16`, `169.254/16`, `100.64/10`, `0/8`, `fc00::/7`,
+/// `fe80::/10`, documentation and multicast ranges, and IPv4-mapped IPv6
+/// forms (`::ffff:a.b.c.d`, including `::ffff:127.0.0.1`) — stays denied
+/// exactly as before. When the variable is unset or carries any other value
+/// the behaviour is byte-identical to upstream. The value is read once per
+/// process.
+pub const EGRESS_ALLOW_LOOPBACK_ENV: &str = "IRONCLAW_EGRESS_ALLOW_LOOPBACK";
+
+/// Whether [`EGRESS_ALLOW_LOOPBACK_ENV`] opted this process in to loopback
+/// egress. Read once; shared by the policy predicates here and by hosted-MCP
+/// endpoint admission (`ironclaw_extension_host::hosted_mcp_admission`).
+pub fn loopback_egress_allowed() -> bool {
+    static FLAG: OnceLock<bool> = OnceLock::new();
+    *FLAG.get_or_init(|| {
+        let enabled =
+            loopback_egress_flag_enabled(std::env::var_os(EGRESS_ALLOW_LOOPBACK_ENV).as_deref());
+        if enabled {
+            tracing::warn!(
+                env = EGRESS_ALLOW_LOOPBACK_ENV,
+                "network policy: loopback (127.0.0.0/8, ::1) exempted from deny_private_ip_ranges"
+            );
+        }
+        enabled
+    })
+}
+
+pub(crate) fn loopback_egress_flag_enabled(value: Option<&OsStr>) -> bool {
+    value
+        .and_then(OsStr::to_str)
+        .map(|raw| raw.trim().to_ascii_lowercase())
+        .is_some_and(|raw| matches!(raw.as_str(), "1" | "true" | "yes" | "on"))
+}
+
+/// `true` when `ip` must be refused under `deny_private_ip_ranges`.
+pub(crate) fn is_denied_private_ip(ip: IpAddr) -> bool {
+    is_denied_private_ip_with(ip, loopback_egress_allowed())
+}
+
+pub(crate) fn is_denied_private_ip_with(ip: IpAddr, allow_loopback: bool) -> bool {
+    is_private_or_loopback_ip(ip) && !(allow_loopback && is_exempt_loopback_ip(ip))
+}
+
+/// Exactly `127.0.0.0/8` or `::1`. IPv4-mapped IPv6 loopback is deliberately
+/// not exempted.
+fn is_exempt_loopback_ip(ip: IpAddr) -> bool {
+    match ip {
+        IpAddr::V4(ip) => ip.is_loopback(),
+        IpAddr::V6(ip) => ip.is_loopback(),
+    }
+}
+
 pub(crate) fn is_private_or_loopback_ip(ip: IpAddr) -> bool {
     match ip {
         IpAddr::V4(ip) => {
@@ -322,3 +379,87 @@ fn is_documentation_v6(ip: std::net::Ipv6Addr) -> bool {
     let segments = ip.segments();
     segments[0] == 0x2001 && segments[1] == 0x0db8
 }
