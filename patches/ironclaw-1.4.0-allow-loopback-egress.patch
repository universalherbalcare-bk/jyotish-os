+#[cfg(test)]
+mod loopback_exemption_tests {
+    use std::{ffi::OsStr, net::IpAddr};
+
+    use super::{is_denied_private_ip_with, loopback_egress_flag_enabled};
+
+    fn ip(s: &str) -> IpAddr {
+        s.parse().unwrap()
+    }
+
+    const LOOPBACK: [&str; 4] = ["127.0.0.1", "127.0.0.2", "127.255.255.254", "::1"];
+    const NON_LOOPBACK_PRIVATE: [&str; 13] = [
+        "10.0.0.5",
+        "172.16.0.1",
+        "172.31.255.255",
+        "192.168.1.1",
+        "169.254.1.1",
+        "100.64.0.1",
+        "0.0.0.0",
+        "192.0.2.1",
+        "fc00::1",
+        "fe80::1",
+        "::",
+        "::ffff:10.0.0.1",
+        "::ffff:127.0.0.1",
+    ];
+    const PUBLIC: [&str; 3] = ["8.8.8.8", "1.1.1.1", "2606:4700::1111"];
+
+    #[test]
+    fn flag_parsing_is_strict_and_off_by_default() {
+        assert!(!loopback_egress_flag_enabled(None));
+        for raw in ["", "0", "false", "no", "off", "2", "loopback"] {
+            assert!(
+                !loopback_egress_flag_enabled(Some(OsStr::new(raw))),
+                "{raw:?}"
+            );
+        }
+        for raw in ["1", "true", "TRUE", "yes", "on", " 1 "] {
+            assert!(
+                loopback_egress_flag_enabled(Some(OsStr::new(raw))),
+                "{raw:?}"
+            );
+        }
+    }
+
+    #[test]
+    fn without_flag_everything_non_public_is_denied() {
+        for host in LOOPBACK.iter().chain(NON_LOOPBACK_PRIVATE.iter()) {
+            assert!(
+                is_denied_private_ip_with(ip(host), false),
+                "{host} must be denied"
+            );
+        }
+        for host in PUBLIC {
+            assert!(
+                !is_denied_private_ip_with(ip(host), false),
+                "{host} must be allowed"
+            );
+        }
+    }
+
+    #[test]
+    fn with_flag_only_loopback_is_exempt() {
+        for host in LOOPBACK {
+            assert!(
+                !is_denied_private_ip_with(ip(host), true),
+                "{host} must be allowed"
+            );
+        }
+        for host in NON_LOOPBACK_PRIVATE {
+            assert!(
+                is_denied_private_ip_with(ip(host), true),
+                "{host} must stay denied"
+            );
+        }
+        for host in PUBLIC {
+            assert!(
+                !is_denied_private_ip_with(ip(host), true),
+                "{host} must be allowed"
+            );
+        }
+    }
+}
